@model IEnumerable<MeetingRoomBooking.ViewModels.RoomViewModel>

@{
    ViewData["Title"] = "Index";
}

<h2 class="mb-3">Meeting Rooms</h2>

<div class="mb-3">
    <a asp-controller="Room" asp-action="Create" class="btn btn-primary">Create New Room</a>
</div>
<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th> Room Name</th>
            <th> Capacity</th>
            <th>Location</th>
            <th>Room Booking Details</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Name</td>
            <td>@item.Capacity</td>
            <td>@item.Location</td>
            <td>
                @* <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | *@
                    <a asp-controller="Room" asp-action="Details" asp-route-roomId="@item.Id" class="btn btn-info">Details</a>
                    <a asp-controller="Room" asp-action="Delete" asp-route-roomId="@item.Id" class="btn btn-danger">Delete</a>
                    <a asp-controller="Booking" asp-action="Create" asp-route-roomId="@item.Id" class="btn btn-success">Book Now</a>

                </td>
        </tr>
}
    </tbody>
</table>
