@model MeetingRoomBooking.ViewModels.RoomBookingViewModel

@{
    ViewData["Title"] = "Detail Room Page";
}
<h2 class="mb-3" style="text-align:center;">Room Details</h2>
<a asp-controller="Room" asp-action="Index" class="btn btn-secondary">Back to List</a>
<div class="border rounded p-3 mb-4">
    <h4 class="mb-3">Room Name : @Model.RoomName</h4>
<p>Capacity : @Model.Capacity</p>
<p>Location : @Model.Location</p>
@* <p>Date : @Model.SelectedDate</p> *@
<form asp-action="Details" asp-controller="Room" method="get" class="mb-3">

    <input type="hidden" name="roomId" value="@Model.RoomId" />

    <label>Select Date:</label>

    <input type="text" id="bookingDate" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
           class="form-control" style="width:250px; display:inline-block;" />

        <button type="submit" class="btn btn-primary showBookingDetails">View Bookings</button>

</form>
</div>

<div class="BookingDetails" style="display: none;">


<h4 style="text-align:center;">Bookings</h4>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Booked By</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Purpose</th>
</tr>
    </thead>
    <tbody>
          @if (Model.Bookings.Any())
        {
            @foreach (var data in Model.Bookings)
            {
                <tr>
                    <td>@data.BookedBy</td>
                    <td>@data.StartTime</td>
                    <td>@data.EndTime</td>
                    <td>@data.Purpose</td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">
                    No bookings available for this date.
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@section Scripts
{
    <script src="~/js/site.js"></script>
}