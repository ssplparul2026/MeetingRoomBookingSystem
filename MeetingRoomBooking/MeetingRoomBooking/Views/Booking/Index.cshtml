@model IEnumerable<MeetingRoomBooking.Models.Booking>
@{
    ViewData["Title"] = "Bookings By Date";
}

<h2 class="mb-3 text-center">Bookings By Date</h2>
<form asp-action="Index" asp-controller="Booking" method="get" class="mb-4">

    <label class="form-label">Select Date</label>

    <input type="text" id="BookingByDate" name="date"value="@(((DateOnly)ViewBag.SelectedDate).ToString("yyyy-MM-dd"))"
           class="form-control"
           style="width:250px;display:inline-block;" />

    <button type="submit" class="btn btn-primary">
        View Bookings
    </button>
</form>
@if (!Model.Any())
{
    <div class="alert alert-info">No bookings found.</div>
}
else
{
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Room Name</th>
                <th>Booking Date</th>
                <th>Booked By</th>
                <th>Start Time</th>
                <th>End Time</th>
                <th>Purpose</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.Room?.Name</td>
                    <td>@booking.BookingDate</td>
                    <td>@booking.BookedBy</td>
                    <td>@booking.StartTime</td>
                    <td>@booking.EndTime</td>
                    <td>@booking.Purpose</td>
                    <td>@booking.Status</td>
                </tr>
            }
        </tbody>
    </table>
}
<div class="mt-3">
    <a asp-controller="Room" asp-action="Index" class="btn btn-secondary">Back to Rooms </a>
</div>
@section Scripts
{
    <script src="~/js/site.js"></script>
}
